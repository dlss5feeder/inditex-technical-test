							"  pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"The response has the expected number of elements and attributes\", () => {",
							"    const responseJson = pm.response.json();",
							"    pm.expect(responseJson.length).to.eql(4);",
							"    const responseJsonElement = responseJson[0];",
							"    pm.expect(responseJsonElement).to.have.property('productId');",
							"    pm.expect(responseJsonElement).to.have.property('brandId');",
